<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <!-- IMPORTANT : cet identifiant doit rester unique et STABLE dans le temps.
       Ne le change pas après la première installation, sinon Outlook considère
       que c'est un nouvel add-in et il faudra tout réinstaller. -->
  <Id>32f59015-6d21-470a-a0f4-aa7e11591ee4</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Marine Composite</ProviderName>
  <DefaultLocale>fr-FR</DefaultLocale>
  <DisplayName DefaultValue="Marine Composite — Enregistrer sur une fiche client"/>
  <Description DefaultValue="Enregistre l'email ouvert sur la fiche du client concerné, dans la plateforme de suivi Marine Composite."/>

  <!-- ATTENTION : remplace ce domaine par celui où tu héberges réellement ce
       dossier (probablement le même GitHub Pages que ta plateforme principale,
       dans un sous-dossier dédié). Toutes les URL ci-dessous en dépendent. -->
  <IconUrl DefaultValue="https://louiselefichous.github.io/outlook-addin/outlook-addin/icons/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://louiselefichous.github.io/outlook-addin/outlook-addin/icons/icon-128.png"/>
  <SupportUrl DefaultValue="https://louiselefichous.github.io/"/>

  <AppDomains>
    <AppDomain>https://louiselefichous.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://louiselefichous.github.io/outlook-addin/outlook-addin/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <!-- Bloc moderne (ruban + volet de tâches), utilisé par Outlook desktop récent,
       Outlook sur le web, et Outlook mobile. Le bloc au-dessus (FormSettings) sert
       de repli pour les très anciennes versions d'Outlook desktop. -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgReadGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="msgReadOpenPaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://louiselefichous.github.io/outlook-addin/outlook-addin/icons/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://louiselefichous.github.io/outlook-addin/outlook-addin/icons/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://louiselefichous.github.io/outlook-addin/outlook-addin/icons/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://louiselefichous.github.io/outlook-addin/outlook-addin/taskpane.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://louiselefichous.github.io/outlook-addin/outlook-addin/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Marine Composite"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Enregistrer sur fiche client"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Enregistre cet email sur la fiche du client concerné, dans la plateforme de suivi."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
